<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rickmorty</groupId>
    <artifactId>rickandmorty-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>RickAndMortyPlugin</name>
    <description>Rick and Morty characters, 3D models, portal gun, shmekle economy for Paper/Spigot 1.20.1</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- API версия: 1.20.4-RADIUS (Paper) совместима с серверами 1.20.1+ -->
        <paper.api.version>1.20.4-R0.1-SNAPSHOT</paper.api.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (обратно совместима с Spigot 1.20.x по большинству API) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            ProtocolLib и ModelEngine — ОПЦИОНАЛЬНЫЕ зависимости.
            Они НЕ подключаются к classpath сборки: плагин определяет их
            наличие в рантайме через Bukkit.getPluginManager().getPlugin(...)
            и работает с ними через рефлексию (см. models/ModelEngineBridge.java).
            Это гарантирует сборку `mvn clean package` без приватных репозиториев.
        -->
    </dependencies>

    <build>
        <finalName>RickAndMortyPlugin-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
